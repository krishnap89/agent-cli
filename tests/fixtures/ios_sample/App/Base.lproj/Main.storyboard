                            </button>
                        </subviews>
                    </view>
                    <connections>
                        <outlet property="loginButton" destination="b1" id="o1"/>
                    </connections>
                </viewController>
            </objects>
        </scene>
        <scene sceneID="s2">
            <objects>
                <viewController storyboardIdentifier="Home" id="Hom-02-def" customClass="HomeViewController" customModule="App" sceneMemberID="viewController"/>
