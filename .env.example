# agent-cli configuration.
#
# Copy this file to .env and uncomment the lines you want to change. Values
# shown are the built-in defaults, so an uncommented line only matters if you
# change its value.
#
# Two locations are checked (first one found wins):
#   1. ./.env                      in the directory you RUN the command from
#                                  (not necessarily the --dir target)
#   2. ~/.config/agent-cli/.env    persistent, used from any directory
#
# Precedence: CLI flags > exported env vars > this .env file > these defaults.
# .env is gitignored; never commit a real AGENT_API_KEY.

# --- Server / model ---------------------------------------------------------
# AGENT_BASE_URL=http://localhost:8000/v1   # OpenAI-compatible endpoint
# AGENT_API_KEY=not-needed                  # secret — keep out of version control
# AGENT_MODEL=qwen
# AGENT_MAX_TOKENS=4096
# AGENT_TEMPERATURE=0.2
# AGENT_TIMEOUT=300                         # seconds per LLM request
# AGENT_STREAM=1                            # stream responses (avoids 504s); 0 to disable
# AGENT_RETRIES=3                           # retries on 429/502/503/504
# AGENT_EXTRA_BODY=                         # extra JSON merged into every request, e.g. {"top_p": 0.8}

# --- Per-role model switching (micro-agent loop) ----------------------------
# AGENT_AUTO_MODEL=0                         # 1 to run each role on its mapped model
# AGENT_MODEL_MAP=                           # JSON, e.g. {"Editor":"code-model","Planner":"reason-model","default":"qwen"}
#                                            # Edit roles: Locator, Planner, Editor, Fixer, Reviewer, Summarizer
#                                            # Analysis roles: Keyworder, Locator, RelevanceGate, Analyst, Diagrammer, Writer

# --- Read-only analysis pipeline (/analyze, and /micro on read requests) -----
# AGENT_ANALYSIS_GATE=1                       # 0 to skip the relevance gate that stops an
#                                            # analysis when the located files don't match the request
# AGENT_ANALYSIS_LLM_KEYWORDS=1              # 0 to skip the Keyworder (an LLM that expands the request
#                                            # into grep synonyms, e.g. authentication -> login/session/token);
#                                            # off = grep only the words typed in the request

# --- Repo map / context -----------------------------------------------------
# AGENT_MAP=1                                # include a repo map in the prompt; 0 to disable
# AGENT_MAP_CHARS=4000                       # repo map size in the prompt
# AGENT_CONTEXT_CHARS=                       # empty/0/inf/none/unlimited = no limit; set a number to cap

# --- Edit / fix loop --------------------------------------------------------
# AGENT_MAX_REFLECTIONS=2                     # coder: retries for failed edits
# AGENT_MAX_FIX_ATTEMPTS=2
# AGENT_MAX_TURNS=30

# --- Linting ----------------------------------------------------------------
# AGENT_LINT=1                                # 0 to disable linting
# AGENT_LINT_CMD=
# AGENT_KTLINT=syntax                         # syntax|full|off

# --- Tests ------------------------------------------------------------------
# AGENT_TEST_CMD=
# AGENT_AUTO_TEST=0
# AGENT_TEST_TIMEOUT=600
# AGENT_CHECK_OUTPUT_CHARS=4000

# --- Android / Gradle -------------------------------------------------------
# AGENT_ANDROID=auto                          # auto|on|off
# AGENT_ANDROID_VARIANT=Debug
# AGENT_COMPILE=                              # on|off; default on when Android is detected
# AGENT_COMPILE_TIMEOUT=600
# AGENT_GRADLE_ARGS=--offline --console=plain -q

# --- Test generation (/test-gen) --------------------------------------------
# AGENT_TESTGEN_EXAMPLES=2
# AGENT_TESTGEN_MAX_FIX=3
# AGENT_TESTGEN_METHODS_PER_STEP=4
# AGENT_TESTGEN_PLAN=1
# AGENT_TESTGEN_ALLOW_GRADLE_EDIT=0

# --- Documentation (/doc) ---------------------------------------------------
# AGENT_DOC_PROPERTIES=0
# AGENT_DOC_VISIBILITY=internal               # public|internal
# AGENT_DOC_PER_STEP=8
# AGENT_DOC_MAX_FIX=2

# --- Jira (read-only) -------------------------------------------------------
# Set all three to let the agent read issues. The token is an API token from
# id.atlassian.com -> Security -> API tokens (not your password). When any is
# unset, the jira_issue / jira_search tools are hidden from the model.
# AGENT_JIRA_URL=https://you.atlassian.net
# AGENT_JIRA_EMAIL=you@company.com
# AGENT_JIRA_TOKEN=
# AGENT_JIRA_TIMEOUT=30                         # seconds per Jira request

# --- Intent routing / notes / skills ----------------------------------------
# AGENT_INTENT_ROUTING=1                       # route plain-language messages to /test-gen or /doc; 0 to disable
# AGENT_NOTES=1
# AGENT_NOTES_FILE=
# AGENT_NOTES_CHARS=3000
# AGENT_SKILL_CHARS=3000

# --- Output / debug ---------------------------------------------------------
# AGENT_DEBUG=
# AGENT_SHOW_THINKING=1                        # one-line gist of the model's reasoning; 0 to hide
# AGENT_THINKING=                              # Qwen3: ""=server default, 0=off, 1=on
# AGENT_KEEP_SPECIAL_TOKENS=1                  # keep <tool_call> special tokens (vLLM); 0 for servers that reject it
